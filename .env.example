# Your API key: dashboard, API Docs, Rotate. It is shown once.
# Never commit the real one: .env is ignored by git.
LEGALSENT_API_KEY=ls_live_XXXXXXXX_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Leave unset to use https://api.legalsent.com
# LEGALSENT_BASE_URL=

# Extra headers on every request, as JSON. Only if you call through a proxy.
# LEGALSENT_EXTRA_HEADERS={"X-Example":"value"}
